    "def day_metrics(y_true, y_pred, day_str):\n",
    "    \"\"\"\n",
    "    Compute sMAPE, RMSE, MAE for a single calendar day.\n",
    "    \"\"\"\n",
    "    day = pd.Timestamp(day_str).normalize()  # 00:00 of that day\n",
    "    start = day\n",
    "    end   = day + pd.Timedelta(days=1) - pd.Timedelta(seconds=1)\n",
    "\n",
    "    y_day    = y_true.slice(start, end)\n",
    "    yhat_day = y_pred.slice(start, end)\n",
    "\n",
    "    if len(y_day) == 0:\n",
    "        print(f\"No data for {day.date()} in the aligned test set.\")\n",
    "        return\n",
